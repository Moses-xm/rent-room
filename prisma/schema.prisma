generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin {
  id       Int       @id @default(autoincrement())
  username String    @unique @db.VarChar(50)
  password String    @db.VarChar(255)
  avatar   String?   @db.VarChar(500)
  isActive Boolean   @default(true)
  modified DateTime? @default(now()) @db.Timestamp(6)
  created  DateTime? @default(now()) @db.Timestamp(6)
}

model user {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  nickname  String?  @db.VarChar(50)
  realname  String?  @db.VarChar(50)
  gender    Int      @default(3)
  identity  Int      @default(1)
  isActive  Boolean  @default(true)
  avatar    String?  @db.VarChar(500)
  email     String?  @db.VarChar(100)
  province  String?  @db.VarChar(30)
  city      String?  @db.VarChar(30)
  district  String?  @db.VarChar(30)
  address   String?  @db.VarChar(200)
  wallet    Float    @default(0)
  payCode   String   @default("000000") @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model community {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  province     String   @db.VarChar(30)
  city         String   @db.VarChar(30)
  district     String   @db.VarChar(30)
  street       String?  @db.VarChar(50)
  streetNumber String?  @db.VarChar(20)
  subwayLine   String?  @db.VarChar(200)
  lng          Float
  lat          Float
  cover        String   @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model carousel {
  id        Int      @id @default(autoincrement())
  image     String   @db.VarChar(500)
  path      String   @db.VarChar(500)
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
