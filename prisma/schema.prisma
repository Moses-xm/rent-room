generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin {
  id       Int       @id @default(autoincrement())
  username String    @unique @db.VarChar(50)
  password String    @db.VarChar(255)
  avatar   String?   @db.VarChar(500)
  isActive Boolean   @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model user {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  nickname  String?  @db.VarChar(50)
  realname  String?  @db.VarChar(50)
  gender    Int      @default(3)
  identity  Int      @default(1)          // 1=普通用户 2=房东
  isActive  Boolean  @default(true)
  avatar    String?  @db.VarChar(500)
  email     String?  @db.VarChar(100)
  province  String?  @db.VarChar(30)
  city      String?  @db.VarChar(30)
  district  String?  @db.VarChar(30)
  address   String?  @db.VarChar(200)
  wallet    Float    @default(0)
  payCode   String   @default("000000") @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms                  room[]
  collections            collection[]
  appointmentsAsUser     appointment[] @relation("appointmentUser")
  appointmentsAsLandlord appointment[] @relation("appointmentLandlord")
  notifications          notification[]
}

model community {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  province     String   @db.VarChar(30)
  city         String   @db.VarChar(30)
  district     String   @db.VarChar(30)
  street       String?  @db.VarChar(50)
  streetNumber String?  @db.VarChar(20)
  subwayLine   String?  @db.VarChar(200)
  lng          Float
  lat          Float
  cover        String   @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms room[]
}

model carousel {
  id        Int      @id @default(autoincrement())
  image     String   @db.VarChar(500)
  path      String   @db.VarChar(500)
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model facility {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  icon      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model room {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(200)
  cmyId       Int
  rentType    Int                          // 1=整租 2=合租
  minTenancy  Int                          // 最短租期（月）
  bedroom     Int
  parlour     Int
  bathroom    Int
  roomType    String    @db.VarChar(20)   // 普通住宅 / 公寓
  direction   String    @db.VarChar(10)
  price       Float
  area        Int
  pledge      Int                          // 押几个月
  pay         Int                          // 付几个月
  floor       Int
  floors      Int
  level       Int                          // 1=低 2=中 3=高
  lift        Int       @default(1)        // 1=无电梯 2=有电梯
  description String?   @db.Text
  cover       String    @db.VarChar(500)
  images      String    @db.Text           // JSON 字符串，多张图片 URL 数组
  facilityIds String    @db.VarChar(500)   // JSON 字符串，设施 ID 数组
  publisherId Int
  isPublished Int       @default(1)        // 1=未发布 2=已发布
  publishTime DateTime?
  roomCode    String    @unique @db.VarChar(20)
  isRented    Int       @default(1)        // 1=未租出 2=已租出
  views       Int       @default(0)
  times       Int       @default(0)
  income      Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community    community     @relation(fields: [cmyId], references: [id])
  publisher    user          @relation(fields: [publisherId], references: [id])
  collections  collection[]
  appointments appointment[]
}

model collection {
  id        Int      @id @default(autoincrement())
  userId    Int
  roomId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id])
  room room @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId])
}

model appointment {
  id              Int      @id @default(autoincrement())
  userId          Int                          // 预约者（租客）
  roomId          Int
  landlordId      Int                          // 房东
  appointmentTime DateTime                     // 预约看房时间
  status          Int      @default(1)         // 1=待看房 2=已完成 3=已取消 4=已过期
  cancelledBy     Int?                         // 取消操作者 userId（status=3 时记录）
  completedBy     Int?                         // 完成标记者 userId（status=2 时记录）
  remark          String?  @db.VarChar(500)    // 预约备注（可选）
  userDeleted     Boolean  @default(false)     // 租客侧隐藏
  landlordDeleted Boolean  @default(false)     // 房东侧隐藏
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     user @relation("appointmentUser",     fields: [userId],     references: [id])
  room     room @relation(fields: [roomId], references: [id])
  landlord user @relation("appointmentLandlord", fields: [landlordId], references: [id])
}

model notification {
  id          Int      @id @default(autoincrement())
  userId      Int                              // 通知接收者
  type        Int                              // 1=新预约 2=预约取消 3=预约完成
  title       String   @db.VarChar(200)
  content     String   @db.VarChar(500)
  relatedType String?  @db.VarChar(50)         // 关联业务类型，如 "appointment"
  relatedId   Int?                             // 关联记录 ID
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user user @relation(fields: [userId], references: [id])
}
