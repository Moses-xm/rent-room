# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string used by Prisma (e.g. a Neon project)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Signing secrets for the two apps (use long random strings)
PORTAL_JWT_SECRET="replace-with-a-long-random-string"
MANAGE_JWT_SECRET="replace-with-a-different-long-random-string"

# Vercel Blob (image uploads)
BLOB_READ_WRITE_TOKEN="replace-with-your-vercel-blob-token"
NEXT_PUBLIC_BLOB_BASE_URL="https://your-store-id.public.blob.vercel-storage.com"

# Baidu Maps browser key (restrict it to your domains in the Baidu console)
NEXT_PUBLIC_BAIDU_MAP_AK="replace-with-your-baidu-map-ak"
